    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icons\add_fixings.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
